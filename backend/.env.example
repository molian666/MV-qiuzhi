# 复制为 .env 后按需修改。.env 不会入库。

# ---------- LLM ----------
# mock（默认，无需任何 Key）：用内置脚本回复，全流程可跑通
# deepseek：真实调用 DeepSeek（OpenAI 兼容接口）
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 实时对话用 chat（延迟优先），批改/生成用 reasoner（质量优先）
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---------- 数据 ----------
# 默认 backend/data；改动后请自行备份
# DATA_DIR=D:/VibeCoding/mianshi/backend/data

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
# 前端 dev server 地址，逗号分隔
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 面试默认参数 ----------
# 一场模拟面试默认问几题
DEFAULT_MAX_QUESTIONS=6

# ---------- 语音（M1） ----------
# mock（默认）：不需要任何 Key。音频照常采集、录制、存档与回放，
#                但"音频→文字"用你输入的文字替代（页面上会明确提示）
# qwen：阿里云百炼实时语音识别（需 DASHSCOPE_API_KEY）
SPEECH_PROVIDER=mock
DASHSCOPE_API_KEY=
DASHSCOPE_REALTIME_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime

# 连续静音多久判定"说完"（M4 起会由面试官画像的 wait_ms 覆盖）
SPEECH_SILENCE_MS=900
# 短于这个时长的"说话"忽略（多半是噪音）
MIN_ANSWER_MS=700
# 判定说完后，等 ASR 出 final 的时间
ASR_WAIT_MS=1500

# ---------- 批量转写（M4：上传面试录音做节奏分析） ----------
# mock（默认）：用你粘贴的对话文稿当转写结果（音频照旧保存，但不会真的识别音频）
# qwen-file：阿里云百炼录音文件转写（含说话人分离）——尚未接入，需 DASHSCOPE_API_KEY
ASR_PROVIDER=mock
DASHSCOPE_ASR_FILE_MODEL=paraformer-v2

# 是否让 httpx / websockets 读系统代理（HTTP_PROXY / HTTPS_PROXY）。
# 默认 false：DeepSeek、百炼都是国内直连，跟着墙外代理走往往直接超时或 403。
# 只有当你的网络确实必须经代理才能访问这些接口时，才改成 true。
TRUST_ENV_PROXY=false

# ---------- 数据导出（M15） ----------
# /api/export/* 的访问令牌。**留空则导出接口一律 401**——本地也不能裸奔：
# 同网段的任何进程都能读走你的全量求职数据（简历、投递、聊天记录、录音转写）。
# 生成一个：python -c "import secrets; print(secrets.token_urlsafe(32))"
EXPORT_TOKEN=
