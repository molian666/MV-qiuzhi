# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 本地数据：SQLite / 音频 / 上传 / 浏览器登录态，绝不能入库 ----
backend/data/
data/
*.db
*.db-wal
*.db-shm

# ---- 密钥与环境变量 ----
.env
.env.local
*.local

# ---- 证书与私钥：部署用的自签证书私钥绝不能入库 ----
backend/certs/
certs/
*.pem
*.key
*.pfx

# ---- Node / 前端 ----
node_modules/
frontend/dist/
frontend/.vite/
*.log

# ---- Pyodide 运行时（~13MB wasm + 标准库 + numpy wheel）----
# 由 frontend/scripts/copy-pyodide.mjs 在 dev/build 前从 node_modules 复制过来，
# 不进仓库；运行时由本机托管，所以 Python 判题能离线用。
frontend/public/pyodide/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 工具运行时数据（Reasonix 任务日志等） ----
.reasonix/
