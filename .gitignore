# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 本地数据：SQLite / 音频 / 上传 / 浏览器登录态，绝不能入库 ----
backend/data/
data/
*.db
*.db-wal
*.db-shm

# ---- 密钥与环境变量 ----
.env
.env.local
*.local

# ---- 证书与私钥：部署用的自签证书私钥绝不能入库 ----
backend/certs/
certs/
*.pem
*.key
*.pfx

# ---- Node / 前端 ----
node_modules/
frontend/dist/
# PyInstaller 打包产物（根目录 dist：mianshi.exe 等，不入库）
dist/
frontend/.vite/
*.log

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 工具运行时数据（Reasonix 任务日志等） ----
.reasonix/

# ---- UI 截图核查产物（本地看界面用，不入库） ----
.ui-shots/

# ---- 临时校验产物（手工实验用，不入库） ----
.tmp-mobile/
.tmp-tests/

# ---- ACL 恢复备份（系统工具生成，非项目内容） ----
.acl-recovery/

# ---- 桌面应用 / 安装包产物（编译产物与 31MB 安装包，不入库） ----
desktop-app/
installer/
installer.zip
