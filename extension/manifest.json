{
  "manifest_version": 3,
  "name": "mianshi 投递同步",
  "version": "0.1.0",
  "description": "在你已登录的招聘网站上读取自己的投递记录，一键同步到本地求职助手（只读你自己的页面，不上传任何第三方）",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://www.zhipin.com/*",
    "https://www.liepin.com/*",
    "https://www.zhaopin.com/*",
    "https://www.51job.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "同步投递记录到本地求职助手"
  }
}
